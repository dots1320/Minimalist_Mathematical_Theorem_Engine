# === Large model artifacts (do not commit; download / regenerate) ===
# Base model: ~15 GB. Re-download via scripts/training/download_7b.py
models/Qwen2.5-7B-Instruct/
# Intermediate merged HF model: ~15 GB. Re-create via scripts/inference/merge_lora.py
models/qwen_7b_v2_merged/
# MLX 4-bit (~4 GB). Either re-create locally, or upload to HuggingFace Hub
models/qwen_7b_v2_mlx_q4/
# Any other model dirs
models/*/

# === Trained adapter weights ===
# adapter_model.safetensors is ~155 MB which exceeds GitHub's 100 MB file limit.
# Either upload to HuggingFace Hub, or use Git LFS.
outputs/qwen_7b_minimalist_engine_v2_trained/adapter_model.safetensors

# === Training artifacts ===
outputs/*/checkpoint-*/
outputs/*/runs/
outputs/*/training_args.bin
*.log

