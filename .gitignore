# === Large model artifacts (do not commit; download / regenerate) ===
# Base, merged, and MLX model directories can be several GB each.
models/

# === Trained adapter weights ===
# adapter_model.safetensors is ~155 MB which exceeds GitHub's 100 MB file limit,
# and the rest of the adapter directory is distributed alongside it on Hugging
# Face. Keep the whole `outputs/` tree out of Git.
outputs/

# === Training artifacts ===
outputs/*/checkpoint-*/
outputs/*/runs/
outputs/*/training_args.bin
data/*_partial.json
data/*_partial.jsonl
*.log

# === Runtime files ===
*.pid
train.log
smoke.log

# === Cloud / temp ===
*.tar.gz
.cache/

# === Local dev scratch (not part of the public release) ===
data/dev/

# === HuggingFace cache (if it lands inside the project) ===
**/huggingface/
