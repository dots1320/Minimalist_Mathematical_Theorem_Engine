# Copy this file to .env, then fill in your own rotated credentials.
# .env is ignored by Git and should never be committed.
# Do not put real credentials in this example file.

OPENAI_API_KEY=YOUR_ROTATED_API_KEY
OPENAI_BASE_URL=YOUR_OPENAI_COMPATIBLE_BASE_URL

# Optional defaults used by helper scripts.
V3_MODEL=mimo-v2.5-pro
V3_DRY_RUN_NUM=1
V3_TARGET=8000
V3_SAVE_EVERY=10
V3_QUALITY_RETRIES=1
V3_API_HTTP_RETRIES=2
V3_API_WORKERS=4
V3_BATCH_API_SIZE=8
V3_BATCH_MAX_TOKENS=5000
V3_API_TIMEOUT=120
